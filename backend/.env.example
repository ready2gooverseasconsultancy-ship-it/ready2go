PORT=4000
FRONTEND_ORIGIN=https://www.ready2gooverseas.com
NODE_ENV=development

# --- CRM Integration ---
# Master switch — set to "false" to return placeholder success (safe for dev/deploy).
CRM_ENABLED=true
CRM_BASE_URL=https://your-crm.example.com
CRM_API_KEY=your_crm_api_key

# Optional tuning
CRM_TIMEOUT=10000
CRM_RETRY_COUNT=3
CRM_RETRY_DELAY=500
